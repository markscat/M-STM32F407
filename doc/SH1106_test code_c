/**
 * @brief ?制位?到 SH1106 ?存（兼容水平?描/MSB优先格式）
 * @param x       起始列 (0-127)
 * @param y       起始行 (0-63)
 * @param bitmap  位??据指?（水平?描，MSB优先）
 * @param w       位??度 (像素)
 * @param h       位?高度 (像素)
 * @param color   ?色 (1:白色, 0:黑色)
 * @note ?据格式：每字?8像素（MSB=左）, 每行字??=ceil(w/8)
 */
void SH1106_DrawBitmap(int16_t x, int16_t y, const uint8_t* bitmap, int16_t w, int16_t h, uint16_t color) {
    // ?界?查
    if (x >= SH1106_WIDTH || y >= SH1106_HEIGHT) return;
    if (x + w < 0 || y + h < 0) return;

    int16_t byteWidth = (w + 7) / 8; // 每行字??
    uint8_t byte = 0;

    for (int16_t j = 0; j < h; j++, y++) {
        if (y < 0 || y >= SH1106_HEIGHT) continue; // 跳?屏幕外的行

        for (int16_t i = 0; i < w; i++) {
            if (x + i < 0 || x + i >= SH1106_WIDTH) continue; // 跳?屏幕外的列

            // 每8像素?取新字?（MSB优先）
            if (i % 8 == 0) {
                byte = bitmap[j * byteWidth + i / 8];
            }
            // ?制像素（若?前位?1）
            if (byte & (0x80 >> (i % 8))) {
                SH1106_DrawPixel(x + i, y, color);
            }
        }
    }
}
